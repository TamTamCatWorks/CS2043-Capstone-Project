<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefWidth="900.0" prefHeight="640.0" styleClass="dashboard-bg"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.tamtamcatworks.auction.client.controller.shell.LayoutController">

    <!-- Top Navigation Bar -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="dashboard-header">
                <padding>
                    <Insets top="7.0" right="16.0" bottom="7.0" left="16.0"/>
                </padding>

                <!-- Brand -->
                <HBox alignment="CENTER" spacing="7.0" onMouseClicked="#handleHeaderBrandClicked" styleClass="header-brand-link">
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <Image url="@../../assets/icons/app-icon.png"/>
                    </ImageView>
                    <Label text="GoodBids" styleClass="header-brand-title"/>
                </HBox>

                <Pane HBox.hgrow="ALWAYS" minWidth="16.0"/>

                <!-- Header Search -->
                <HBox fx:id="headerSearchShell" alignment="CENTER_LEFT" spacing="6.0" styleClass="header-search-shell">
                    <FontIcon iconLiteral="mdi2m-magnify" iconSize="15" styleClass="header-search-icon"/>
                    <TextField fx:id="headerSearchField" promptText="Search auctions..." styleClass="header-search-field" prefWidth="440.0"
                               onAction="#handleHeaderSearchCommitted"/>
                    <Pane styleClass="header-search-divider" prefWidth="1.0" prefHeight="18.0"/>
                    <ComboBox fx:id="headerCategoryFilter" styleClass="header-category-filter" prefWidth="150.0"/>
                </HBox>

                <Pane HBox.hgrow="ALWAYS" minWidth="16.0"/>

                <Button fx:id="headerCreateAuctionButton" text="" styleClass="header-icon-button" onAction="#handleHeaderCreateAuction">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-plus" iconSize="16"/>
                    </graphic>
                </Button>

                <!-- User Menu -->
                <MenuButton fx:id="userMenuButton" text="" contentDisplay="GRAPHIC_ONLY" styleClass="user-menu-btn"
                            onShowing="#handleUserMenuOpened">
                    <graphic>
                    <FontIcon iconLiteral="mdi2a-account-circle" iconSize="19"/>
                    </graphic>
                    <items>
                        <MenuItem fx:id="userNameItem" text="User" disable="true"/>
                        <MenuItem fx:id="userEmailItem" text="email" disable="true"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Dashboard" onAction="#handleNavDashboard">
                            <graphic>
                                <FontIcon iconLiteral="mdi2v-view-dashboard" iconSize="14"/>
                            </graphic>
                        </MenuItem>
                        <MenuItem fx:id="adminPanelItem" text="Admin Panel" onAction="#handleOpenAdminPanel">
                            <graphic>
                                <FontIcon iconLiteral="mdi2s-shield-account" iconSize="14"/>
                            </graphic>
                        </MenuItem>
                        <SeparatorMenuItem/>
                        <MenuItem fx:id="notificationsHeaderItem" text="Notifications" onAction="#handleOpenNotificationsFromMenu"/>
                        <SeparatorMenuItem fx:id="notificationsSeparatorItem"/>
                        <MenuItem text="Sign Out" onAction="#handleLogout">
                            <graphic>
                                <FontIcon iconLiteral="mdi2l-logout" iconSize="14"/>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>
        </VBox>
    </top>

    <!-- Content Slot -->
    <center>
        <StackPane fx:id="mainContentArea"
                   BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
